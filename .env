# =============================================================================
# DexaOCR Worker — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.
# =============================================================================

# ── Worker Identity ───────────────────────────────────────────────────────────
WORKER_NAME=DexaOCR
SCHEMA_VERSION=1.0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost/
#RABBITMQ_URL=amqp://admin:Senh%40123@192.168.1.219:5672/
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_INPUT=worker.dexaocr.request
RABBITMQ_QUEUE_OUTPUT=orchestra.worker_results
RABBITMQ_PREFETCH=1
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10
RABBITMQ_RETRY_DELAY=5
RABBITMQ_MAX_RETRIES=0

# ── AgileAI SQL Server ────────────────────────────────────────────────────────
# Multiple hosts separated by semicolons (tried in order)
SQL_HOSTS=192.168.1.211
SQL_DB=AgileAI
SQL_UID=sasys
SQL_PWD=Udi20014625210
SQL_PORT=1433
SQL_ENCRYPT=no
SQL_TRUST_CERT=yes
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Legacy dexa_ocr keys (kept for backward compatibility with CLI mode)
AGILEAI_SQL_HOSTS=192.168.1.211;201.48.134.100
AGILEAI_SQL_DB=AgileAI
AGILEAI_SQL_UID=sasys
AGILEAI_SQL_PWD=Udi20014625210
AGILEAI_SQL_PORT=1433
AGILEAI_SQL_ENCRYPT=no
AGILEAI_SQL_TRUST_CERT=yes
AGILEAI_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── OCR Engine ────────────────────────────────────────────────────────────────
OCR_ENGINE=paddleocr
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=por+eng
PADDLEOCR_LANG=pt
OCR_TABLE_WHITELIST=0123456789.,-LlTtWwCcDd aboréáíú
DEFAULT_RESIZE_WIDTH=2200
PNG_COMPRESS_LEVEL=3
# Extra OCR attempts when result is missing L1-L4 (coluna lombar) or Colo (fêmur).
# 0 = sem retentativa. 2 = até 3 tentativas no total.
OCR_MAX_RETRIES=3

# ── Image Processing ──────────────────────────────────────────────────────────
ROI_STRATEGY=contour
SAVE_DEBUG_IMAGES=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs\dexa_worker.log

# ── Work Directory (temp files per request, one subfolder per request_id) ─────
WORK_BASE_DIR=work

# Saída
DEFAULT_OUTPUT_DIR=output


# -- DICOM Roots
# Paths raiz onde os DICOMs estao armazenados, separados por ponto-e-virgula.
# O sistema tenta cada path em ordem ate encontrar o arquivo.
DICOM_ROOTS=\\192.168.1.155\dcms_new_ssd_01\DCMs;\\192.168.1.155\Dados\Database\Dcms;\\192.168.1.60\dcms
DICOM_NETWORK_USERNAME=administrador@telepacs.com
DICOM_NETWORK_PASSWORD=2028?Avant!@gil3#.
